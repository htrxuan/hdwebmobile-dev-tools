<?php

namespace htrxuan\__NS__;

if (!defined('ABSPATH')) {
    exit;
}

final class __PREFIX___Core
{

    private static $instance = null;

    public static function get_instance()
    {
        if (null === self::$instance) {
            self::$instance = new self();
        }
        return self::$instance;
    }

    private function __construct()
    {
        $this->includes();
        $this->init_hooks();
    }

    private function __clone()
    {
    }

    private function includes()
    {
        require_once __PREFIX___PLUGIN_DIR . 'includes/class-__NS__-admin.php';
        // TODO: require_once your feature classes here, e.g.:
        // require_once __PREFIX___PLUGIN_DIR . 'includes/class-__NS__-repository.php';
        // require_once __PREFIX___PLUGIN_DIR . 'includes/class-__NS__-frontend.php';
    }

    private function init_hooks()
    {
        add_action('admin_notices', array($this, 'render_missing_woocommerce_notice'));

        if (!class_exists('WooCommerce')) {
            return;
        }

        // __PREFIX___Admin owns the hdwebmobile_hub_tabs registration used by the shared hub
        // page, so it must load unconditionally (not only when is_admin()).
        __PREFIX___Admin::get_instance();

        // TODO: instantiate your feature classes here, e.g.:
        // __PREFIX___Frontend::get_instance();
    }

    public function render_missing_woocommerce_notice()
    {
        $screen = get_current_screen();
        if (!$screen || 'plugins' !== $screen->id) {
            return;
        }

        if (!get_transient('__NS___wc_missing_notice')) {
            return;
        }
        delete_transient('__NS___wc_missing_notice');
        ?>
        <div class="notice notice-error is-dismissible">
            <p>
                <?php esc_html_e('__NAME__ requires WooCommerce to be installed and active. The plugin has been deactivated.', '__SLUG__'); ?>
            </p>
        </div>
        <?php
    }
}
