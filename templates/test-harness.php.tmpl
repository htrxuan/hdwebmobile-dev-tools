/**
 * Standalone PHP-level test suite for __NAME__.
 * Run via:  wp eval-file test-__NS__.php   (from the WordPress root, i.e. cd to the site
 * first -- `wp eval-file` resolves paths relative to the WP install, not this file's location)
 *
 * COPY THIS FILE, don't run it as-is -- replace __NS__ / __PREFIX__ with the real values and
 * fill in real assertions. It exists to bake in two lessons learned the hard way this session:
 *
 *   1. `global $P, $F;` inside a function does NOT work here: this file is eval()'d by
 *      `wp eval-file` with its own top-level variable scope, and PHP's `global` keyword only
 *      reaches the true top-level/superglobal scope -- not "the scope this script happened to
 *      define $P in". The counters silently stayed at their initial value and the final tally
 *      printed "0 passed, 0 failed" even though every individual PASS/FAIL line was correct.
 *      Fix: use $GLOBALS['...'] explicitly everywhere, both to set and to read.
 *
 *   2. A regex/substring check against "does this file avoid mentioning X" will false-positive
 *      on X appearing in a comment or docblock (e.g. a docblock that explains "this never
 *      touches $wpdb" contains the literal string "$wpdb"). Strip comments before searching
 *      code for a forbidden pattern: `preg_replace('!/\*.*?\*\/!s', '', $source)`.
 */

namespace htrxuan\__NS__;

$GLOBALS['__NS___P'] = 0;
$GLOBALS['__NS___F'] = 0;

function check($label, $cond)
{
    if ($cond) {
        $GLOBALS['__NS___P']++;
        echo "PASS: $label\n";
    } else {
        $GLOBALS['__NS___F']++;
        echo "FAIL: $label\n";
    }
}

